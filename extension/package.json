{
  "name": "simplegtd",
  "displayName": "Simple GTD for Markdown",
  "version": "0.0.3",
  "description": "Manage tasks in plain Markdown lists.",
  "license": "UNLICENSED",
  "publisher": "geb-algebra",
  "icon": "icon.png",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "cd ../spa && bun x vite build --config vite.webview.config.ts && cd ../extension && bun build extension.ts --target=node --format=cjs --external vscode --outfile dist/extension.cjs",
    "package": "bun run build && bun x @vscode/vsce@4.1.1 package --no-dependencies --allow-missing-repository"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "simpleGtd",
          "title": "Simple GTD",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "simpleGtd": [
        {
          "id": "simpleGtd.workspace",
          "name": "Simple GTD",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "simpleGtd.selectFolder",
        "title": "Simple GTD: Select Workspace Folder"
      },
      {
        "command": "simpleGtd.addSelectionToInbox",
        "title": "Simple GTD: Add Selected List Items to Inbox",
        "enablement": "editorLangId == markdown && editorHasSelection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "simpleGtd.addSelectionToInbox",
          "when": "editorLangId == markdown && editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Simple GTD",
      "properties": {
        "simpleGtd.projectCommand": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "VS Code command ID called with { name, folderUri } to create a project from an Inbox task."
        }
      }
    }
  },
  "activationEvents": [
    "onView:simpleGtd.workspace"
  ],
  "engines": {
    "vscode": "^1.85.0"
  }
}
